{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/angelofernand0/omniriff/protocol/coach.schema.json",
  "title": "OmniRiff coach feed v1",
  "description": "Loopback WebSocket ws://127.0.0.1:47803, served by the coach process (coach/feed.py). Coach -> dashboard: coach.frame, a full snapshot every time anything changes (the dashboard renders the latest one; no deltas). Coach -> dashboard: coach.audio, the spoken cue as ElevenLabs audio (the API key stays in the coach process). Dashboard -> coach: coach.approve / coach.reject for the pending approval. Display and approval only: rig changes still go through the control envelope on UDP 47800 with source 'coach'.",
  "oneOf": [
    {
      "$ref": "#/$defs/frame"
    },
    {
      "$ref": "#/$defs/audio"
    },
    {
      "$ref": "#/$defs/decision"
    }
  ],
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "timestamp_ms",
        "session_id",
        "take_id",
        "state",
        "mood",
        "target",
        "cue",
        "todos",
        "drill_card",
        "before_after",
        "awaiting_approval",
        "activity"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "coach.frame"
        },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Unix wall clock, ms."
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "take_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "description": "The take the coach is working on (take sidecar take_id), or null."
        },
        "state": {
          "enum": [
            "asleep",
            "idle",
            "listening",
            "thinking",
            "speaking",
            "pointing",
            "pleased"
          ],
          "description": "What Riff is doing. Same names as dashboard/riff.js. asleep = no coach or coach out of service."
        },
        "mood": {
          "enum": [
            "neutral",
            "curious",
            "concentrating",
            "aha",
            "concerned",
            "encouraging",
            "proud",
            "sleepy"
          ],
          "description": "Riff's facial expression (R3b). Must follow a real event: aha when a finding lands, concerned when naming a mistake, encouraging while awaiting approval, proud after an improved take."
        },
        "target": {
          "enum": [
            "loop",
            "filter",
            "reverb",
            "bypass",
            "input",
            "hand",
            "coach",
            "player",
            null
          ],
          "description": "What Riff moves to or looks at. Logical names; the dashboard maps them to elements. player = look straight out at the guitarist. null = home dock."
        },
        "cue": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 240,
          "description": "What Riff says, at most two sentences: the cause, then the fix. Spoken by the voice layer when it changes."
        },
        "todos": {
          "type": "array",
          "maxItems": 12,
          "description": "The agent's plan (deepagents write_todos), in order.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "status"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "status": {
                "enum": [
                  "pending",
                  "in_progress",
                  "completed"
                ]
              }
            }
          }
        },
        "drill_card": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skill",
                "title",
                "passage",
                "reps",
                "pass_rule",
                "rig",
                "journal_path"
              ],
              "properties": {
                "skill": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                  "maxLength": 64,
                  "description": "Skill folder name, e.g. keep-the-hand-moving."
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 60
                },
                "passage": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "What to play, e.g. 'G to C change, bars 2-3'."
                },
                "reps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "pass_rule": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "description": "Measurable, e.g. 'longest gap under 150 ms'."
                },
                "rig": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "Rig settings the drill wants. Applied only after approval.",
                  "properties": {
                    "bypass": {
                      "type": "boolean"
                    },
                    "filter": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "reverb": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                "journal_path": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 200,
                  "description": "Where the agent wrote it in its workspace, e.g. /journal/s1/take-3.md."
                }
              }
            }
          ]
        },
        "before_after": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "before_take_id",
                "after_take_id",
                "hesitations",
                "worst_gap_ms",
                "tempo_stability",
                "improved"
              ],
              "properties": {
                "before_take_id": {
                  "type": "string",
                  "maxLength": 64
                },
                "after_take_id": {
                  "type": "string",
                  "maxLength": 64
                },
                "hesitations": {
                  "$ref": "#/$defs/pairInt"
                },
                "worst_gap_ms": {
                  "$ref": "#/$defs/pairNum"
                },
                "tempo_stability": {
                  "$ref": "#/$defs/pairNum"
                },
                "improved": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "awaiting_approval": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "summary",
                "actions",
                "expires_unix_ms"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "summary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "description": "Plain sentence, e.g. 'Effects off and loop cleared for the drill.'"
                },
                "actions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "control"
                    ],
                    "properties": {
                      "control": {
                        "enum": [
                          "filter",
                          "reverb",
                          "loop",
                          "bypass"
                        ]
                      },
                      "value": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  }
                },
                "expires_unix_ms": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "activity": {
          "type": "array",
          "maxItems": 8,
          "description": "The harness at work, newest last: what the coach and its subagents are doing now. Shown as a small live strip so judges see subagents, tools and skills run.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "who",
              "what",
              "status"
            ],
            "properties": {
              "who": {
                "enum": [
                  "coach",
                  "ears",
                  "eyes"
                ]
              },
              "what": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "Tool or step, e.g. get_take_report, open skill keep-the-hand-moving, write /journal/s1/take-3.md"
              },
              "status": {
                "enum": [
                  "running",
                  "done",
                  "failed",
                  "waiting"
                ]
              }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "timestamp_ms",
        "approval_id"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "enum": [
            "coach.approve",
            "coach.reject"
          ]
        },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0
        },
        "approval_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "pairInt": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "description": "[before, after]"
    },
    "pairNum": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "description": "[before, after]"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "timestamp_ms",
        "text",
        "mime",
        "audio_b64"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "coach.audio"
        },
        "timestamp_ms": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "description": "Exactly the cue it speaks. The dashboard plays it only if it equals the current frame's cue."
        },
        "mime": {
          "enum": [
            "audio/mpeg"
          ]
        },
        "audio_b64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 2000000,
          "description": "Base64 MP3. Cues are two sentences, so this stays small."
        }
      }
    }
  }
}
