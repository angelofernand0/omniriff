{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "seq",
    "timestamp_ms",
    "type",
    "control"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "enum": [
        "arduino",
        "vision",
        "sensecap",
        "dashboard",
        "manual",
        "coach"
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "enum": [
        "parameter",
        "action"
      ]
    },
    "control": {
      "enum": [
        "filter",
        "reverb",
        "loop",
        "bypass",
        "practice"
      ]
    },
    "value": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "parameter"
        },
        "control": {
          "enum": [
            "filter",
            "reverb"
          ]
        }
      },
      "required": [
        "value",
        "confidence"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "action"
        },
        "control": {
          "enum": [
            "loop",
            "bypass"
          ]
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "value"
            ]
          },
          {
            "required": [
              "confidence"
            ]
          }
        ]
      }
    },
    {
      "description": "R24: the player asks for a practice session (pedal long-press, dashboard or keyboard). The engine never applies it to audio; it is counted in state.pedal for the coach.",
      "properties": {
        "type": {
          "const": "action"
        },
        "control": {
          "const": "practice"
        },
        "source": {
          "enum": [
            "arduino",
            "dashboard",
            "manual"
          ]
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "value"
            ]
          },
          {
            "required": [
              "confidence"
            ]
          }
        ]
      }
    }
  ]
}
