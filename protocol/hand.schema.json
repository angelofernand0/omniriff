{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/angelofernand0/omniriff/protocol/hand.schema.json",
  "title": "OmniRiff hand-view frame v1",
  "description": "Optional loopback display feed from vision/ (ws://127.0.0.1:47802). Display only: never a control input, never camera pixels. landmarks are the tracked hand's 21 MediaPipe points in normalized image coordinates, or [] when no hand is present.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "timestamp_ms", "present", "engaged", "confidence", "control", "value", "landmarks"],
  "properties": {
    "version": { "const": 1 },
    "type": { "const": "hand" },
    "timestamp_ms": { "type": "integer", "minimum": 0 },
    "present": { "type": "boolean" },
    "engaged": { "type": "boolean", "description": "Clutch/pinch currently driving the control. present && !engaged does NOT mean armed: the controller may be waiting for an open-hand re-arm." },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "control": { "enum": ["filter", "reverb", null], "description": "null in Scene Morph mode, where value is the morph position." },
    "value": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 1 }, { "type": "null" }] },
    "landmarks": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "number", "minimum": 0, "maximum": 1 },
          { "type": "number", "minimum": 0, "maximum": 1 }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  },
  "if": { "properties": { "present": { "const": true } } },
  "then": { "properties": { "landmarks": { "minItems": 21, "maxItems": 21 } } },
  "else": { "properties": { "landmarks": { "maxItems": 0 } } }
}
